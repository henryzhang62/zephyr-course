menuconfig LED_SUBSYSTEM
	bool "LED Subsystem"
	default y
	help
	  Enable the heartbeat LED application.

if LED_SUBSYSTEM

config APP_HEARTBEAT_PERIOD_MS
	int "Heartbeat LED period (ms)"
	range 100 2000
	default 500

menuconfig LED_ADVANCED
	bool "Advanced LED settings"
	default n

if LED_ADVANCED

config LED_BRIGHTNESS
	int "LED brightness (0-100)"
	range 0 100
	default 100

config LED_FADE_DURATION_MS
	int "LED fade duration (ms)"
	range 0 60000
	default 500

menu "Expert settings"

config LED_DEBUG
	bool "Enable LED debugging"
	default n
config LED_CUSTOM_BLINK_PATTERN
	bool "Custom blink pattern"
	default n
endmenu

endif # LED_ADVANCED
endif # LED_SUBSYSTEM

rsource "drivers/sensor/led_sensor/Kconfig"

source "Kconfig.zephyr"
